---
// The newest few months of apod.json, built into the page so the grid shows them at once
// while the full archive loads in the background.
// The page's <style> and <script> are is:inline, so Astro leaves them as written: the script
// builds its own elements and loads pagefind/ at run time, which scoping or bundling would break.
import { readFile } from 'node:fs/promises';
import InfoIcon from '@tabler/icons/outline/info-circle.svg';
import GitHubIcon from '@tabler/icons/outline/brand-github.svg';
import TimelineIcon from '@tabler/icons/outline/layout-sidebar-right.svg';

const MONTHS = 3;
const entries = JSON.parse(await readFile('apod.json', 'utf8'))
  .filter((e) => e && e.date && e.link)
  .sort((a, b) => (a.date < b.date ? 1 : -1));
// Whole months only, so the page can carry on from apod.json where these end.
const keys = new Set([...new Set(entries.map((e) => e.date.slice(0, 7)))].slice(0, MONTHS));
const recent = entries.filter((e) => keys.has(e.date.slice(0, 7)));
const seed = recent.length ? { total: entries.length, earliest: entries[entries.length - 1].date, recent } : null;
// Escaping every "<" keeps a "</script>" in a title from ending the script element.
const seedJson = seed ? JSON.stringify(seed).replace(/</g, '\\u003c') : '';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>APOD Grid</title>
<meta name="description" content="NASA's Astronomy Picture of the Day, every day since 1995, on one page.">
<meta property="og:type" content="website">
<meta property="og:url" content="https://liambeckman.com/apod-grid/">
<meta property="og:title" content="APOD Grid">
<meta property="og:description" content="NASA's Astronomy Picture of the Day, every day since 1995, on one page.">
<meta property="og:image" content="https://liambeckman.com/apod-grid/og.jpg">
<meta property="og:image:width" content="960">
<meta property="og:image:height" content="600">
<meta name="twitter:card" content="summary_large_image">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;800&family=IBM+Plex+Mono:wght@400;500&display=swap">
<style is:inline>
/* Layout: a sticky toolbar, then month-by-month sections of square thumbnails, newest first, loading older months as you scroll. */
:root {
  --sky: #07090f;        /* page background: night sky */
  --panel: #10141f;      /* toolbar and tile placeholder */
  --line: #1f2636;       /* hairlines and borders */
  --star: #e8ecf5;       /* primary text */
  --dust: #8a93a8;       /* secondary text */
  --glow: #f2b84b;       /* accent: warm starlight */
  --font-display: "Archivo", system-ui, sans-serif;
  --font-body: "Archivo", system-ui, sans-serif;
  --font-mono: "IBM Plex Mono", ui-monospace, Menlo, monospace;
  --gutter: max(16px, env(safe-area-inset-left, 0px));
  color-scheme: dark;
}
* { box-sizing: border-box; }
html, body { margin: 0; }
body {
  background: var(--sky);
  color: var(--star);
  font: 15px/1.5 var(--font-body);
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
}
a { color: inherit; }
button, input { font: inherit; color: inherit; }
:focus-visible { outline: 2px solid var(--glow); outline-offset: 2px; }

header.bar {
  position: sticky; top: env(safe-area-inset-top, 0px); z-index: 5;
  display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px;
  padding-block: 14px;
  margin-inline: calc(-1 * max(16px, env(safe-area-inset-left, 0px))) calc(-1 * max(16px, env(safe-area-inset-right, 0px)));
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
  background: color-mix(in srgb, var(--sky) 88%, transparent);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--line);
}
.brand { display: flex; align-items: baseline; gap: 10px; margin-right: auto; }
.brand h1 { margin: 0; font: 800 20px/1 var(--font-display); letter-spacing: -0.01em; }
.brand h1 span { color: var(--glow); }
.brand small { font: 400 12px var(--font-mono); color: var(--dust); }
.controls { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; min-width: 0; }
.controls input {
  background: var(--panel); border: 1px solid var(--line); border-radius: 6px;
  padding: 6px 8px; font-family: var(--font-mono); font-size: 13px;
}
.controls input[type="search"] { width: 16em; max-width: 100%; font-family: var(--font-body); font-size: 14px; }
.btn {
  background: var(--panel); border: 1px solid var(--line); border-radius: 6px;
  display: inline-flex; align-items: center; gap: 6px;
  padding: 6px 12px; cursor: pointer; text-decoration: none; font-size: 14px; white-space: nowrap;
}
/* Icons are Tabler's (MIT), imported as components in the frontmatter. They're drawn with
   strokes in the text colour. */
.btn .icon { width: 16px; height: 16px; flex: none; }
.btn:hover { border-color: var(--dust); }
.btn.icon-only { padding-inline: 8px; }
.btn[aria-pressed="true"] { color: var(--glow); }
.btn.accent { background: var(--glow); border-color: var(--glow); color: #1a1205; font-weight: 600; }

main { padding-block: 8px 48px; }
section.month { margin-top: 28px; }
section.month h2 {
  display: flex; align-items: baseline; gap: 12px;
  margin: 0 0 10px; font: 600 18px/1.2 var(--font-display);
}
section.month h2 span { font: 400 12px var(--font-mono); color: var(--dust); }

.grid {
  display: grid; gap: 0px;
  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
}
@media (min-width: 900px) { .grid { grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); } }

.tile {
  position: relative; display: block; aspect-ratio: 1; max-width: 100%;
  overflow: hidden; background: var(--panel); border-radius: 0px; text-decoration: none;
}
.tile img {
  width: 100%; height: 100%; object-fit: cover; display: block;
  opacity: 0; transition: opacity .35s ease, transform .5s ease;
}
.tile img.loaded { opacity: 1; }
.tile:hover img, .tile:focus-visible img { transform: scale(1.04); }
.cap {
  position: absolute; inset: auto 0 0 0; padding: 22px 9px 8px;
  display: grid; gap: 1px;
  background: linear-gradient(transparent, rgba(4, 6, 10, .88));
  opacity: 0; transition: opacity .2s ease;
}
.tile:hover .cap, .tile:focus-visible .cap, .tile.noimg .cap { opacity: 1; }
.cap .d { font: 500 11px var(--font-mono); color: var(--glow); letter-spacing: 0.04em; }
.cap .t { font: 600 13px/1.25 var(--font-body); color: #f4f6fb;
  display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
.cap .c { font: 400 11px/1.3 var(--font-body); color: #c3cad8;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.more { margin-top: 16px; }
.badge {
  position: absolute; top: 6px; right: 6px; padding: 2px 6px; border-radius: 3px;
  font: 500 10px var(--font-mono); text-transform: uppercase; letter-spacing: 0.08em;
  background: rgba(4, 6, 10, .75); color: #f4f6fb;
}
.tile.noimg { background: radial-gradient(circle at 30% 25%, #1b2233, var(--panel)); }
/* The day named in the address (?date=YYYY-MM-DD), outlined for a moment. */
.tile.flash::after { content: ''; position: absolute; inset: 0; box-shadow: inset 0 0 0 3px var(--glow); animation: flash 2.5s ease forwards; }
@keyframes flash { 0%, 60% { opacity: 1; } 100% { opacity: 0; } }
.tile.noimg .cap { background: none; inset: auto 0 0 0; }

.status { margin: 32px 0; display: flex; flex-wrap: wrap; align-items: center; gap: 12px; color: var(--dust); font-size: 14px; }
.status.error { color: #ff9b8a; }
.spinner { width: 14px; height: 14px; border-radius: 50%; border: 2px solid var(--line); border-top-color: var(--glow); animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
#sentinel { height: 1px; }
footer { color: var(--dust); font-size: 12px; padding-block: 0 32px; max-width: 65ch; }

@media (prefers-reduced-motion: reduce) {
  .tile img, .cap { transition: none; }
  .tile:hover img { transform: none; }
  .spinner { animation: none; }
}
@media (max-width: 560px) {
  .grid { grid-template-columns: repeat(3, 1fr); gap: 0px; }
  .cap .t { -webkit-line-clamp: 2; font-size: 12px; }
  /* Search shrinks so the buttons stay on its row. */
  .controls { width: 100%; flex-wrap: nowrap; }
  .controls input[type="search"] { flex: 1; width: auto; min-width: 0; }
}

/* Timeline: a minimap of the whole archive down the right edge, newest at the top, with hashes
   like the iOS photo straightening wheel. It has a column of its own beside the grid. */
:root { --rail-w: 60px; }
main, .status, footer { margin-right: var(--rail-w); }
.rail {
  position: fixed; z-index: 4;
  top: calc(env(safe-area-inset-top, 0px) + var(--bar-h, 64px) + 12px); bottom: 16px;
  right: max(8px, env(safe-area-inset-right, 0px)); width: var(--rail-w);
  display: flex; flex-direction: column;
}
.rail[hidden], .no-rail .rail { display: none; }
.no-rail { --rail-w: 0px; }
.rail-track {
  position: relative; flex: 1; min-height: 0; cursor: pointer; border-radius: 6px;
  touch-action: none; user-select: none; -webkit-user-select: none;
}
.rail-track canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; transition: opacity .2s ease; }
.rail-track.idle canvas { opacity: .45; }
.rail-bubble {
  position: absolute; right: calc(100% + 4px); transform: translateY(-50%); white-space: nowrap; pointer-events: none;
  background: var(--panel); border: 1px solid var(--line); border-radius: 6px; padding: 4px 8px;
  font: 500 12px var(--font-mono); color: var(--star); box-shadow: 0 4px 16px rgba(0, 0, 0, .5);
}
</style>
</head>
<body>
<header class="bar">
  <div class="brand">
    <h1>APOD <span>Grid</span></h1>
    <small id="count">Astronomy Picture of the Day</small>
  </div>
  <div class="controls">
    <input type="search" id="q" placeholder="Search titles, credits, text" aria-label="Search" autocomplete="off" spellcheck="false">
    <a class="btn" href="about.html"><InfoIcon class="icon" aria-hidden="true" />About</a>
    <a class="btn" href="https://github.com/lbeckman314/apod-grid" target="_blank" rel="noopener"><GitHubIcon class="icon" aria-hidden="true" />GitHub</a>
    <button class="btn icon-only" id="railToggle" type="button" aria-pressed="true" aria-label="Timeline" title="Show or hide the timeline"><TimelineIcon class="icon" aria-hidden="true" /></button>
  </div>
</header>

<nav class="rail" id="rail" aria-label="Timeline" hidden>
  <div class="rail-track" id="railTrack" role="slider" tabindex="0" aria-label="Month" aria-orientation="vertical">
    <canvas id="railDial"></canvas>
    <div class="rail-bubble" id="railBubble" hidden></div>
  </div>
</nav>

<div id="page">
<main id="main"></main>
<div id="status" class="status" hidden></div>
<div id="sentinel"></div>
<footer>
  Pictures and text from NASA's <a href="https://science.nasa.gov/apod/" target="_blank" rel="noopener">Astronomy Picture of the Day</a>.
  Some images are copyrighted by their photographers. Each tile opens that day's page on science.nasa.gov.
  <a href="about.html">About this site</a> · <a href="https://github.com/lbeckman314/apod-grid" target="_blank" rel="noopener">Source on GitHub</a>
</footer>
</div>

<!-- The newest months of apod.json (see the top of this file), so they show without waiting for it. -->
<script type="application/json" id="seed" is:inline set:html={seedJson}></script>
<script is:inline>
(() => {
  // Built by fetch-apod.mjs. Serve this folder over HTTP; browsers won't load it from file://.
  const DATA_URL = 'apod.json';
  const MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];

  const $ = (id) => document.getElementById(id);
  const main = $('main'), statusEl = $('status'), sentinel = $('sentinel');

  // Scroll the page to `top`. While the timeline is being dragged, the page is shifted there
  // instead and scrolled when the pointer is up: iOS reports a pointer's position off by any
  // scrolling that happens while it's down.
  const page = $('page');
  let shift = 0; // px the page is shown past scrollY
  const pageTop = () => scrollY + shift;
  const maxTop = () => page.offsetTop + page.offsetHeight - innerHeight; // a shift doesn't change it
  function scrollPage(top) {
    top = Math.max(0, Math.min(top, maxTop()));
    if (!drag) { window.scrollTo({ top }); return; }
    shift = top - scrollY;
    page.style.transform = shift ? `translateY(${-shift}px)` : '';
  }
  function release() {
    if (!shift) return;
    const top = pageTop();
    shift = 0;
    page.style.transform = '';
    window.scrollTo({ top });
  }
  const shortDate = (iso) => `${MONTHS[+iso.slice(5, 7) - 1].slice(0, 3)} ${+iso.slice(8, 10)}, ${iso.slice(0, 4)}`;

  let all = [];          // every entry, newest first
  let months = [];       // [{ key: 'YYYY-MM', items }], newest first
  let first = 0;         // index into months of the newest one rendered
  let next = 0;          // index into months of the next one to render
  let searching = false; // while showing search results, scrolling doesn't add months
  let complete = false;  // false while only the newest months built into the page are loaded
  let archive;           // resolves once apod.json has loaded or failed

  function setStatus(kind, text) {
    if (!kind) { statusEl.hidden = true; statusEl.replaceChildren(); return; }
    statusEl.hidden = false;
    statusEl.className = 'status' + (kind === 'error' ? ' error' : '');
    statusEl.replaceChildren();
    if (kind === 'loading') { const s = document.createElement('span'); s.className = 'spinner'; statusEl.append(s); }
    statusEl.append(document.createTextNode(text));
  }

  // --- rendering -----------------------------------------------------------
  function tile(it) {
    const a = document.createElement('a');
    a.className = 'tile';
    a.href = it.link;
    a.target = '_blank'; a.rel = 'noopener';
    a.title = `${it.title} (${it.date})`;
    a.dataset.date = it.date;

    const srcs = [it.thumb, it.image].filter(Boolean);
    if (srcs.length) {
      const img = document.createElement('img');
      img.loading = 'lazy'; img.decoding = 'async'; img.alt = it.alt || it.title;
      img.referrerPolicy = 'no-referrer';
      let i = 0;
      img.onload = () => img.classList.add('loaded');
      img.onerror = () => {
        i++;
        if (i < srcs.length) img.src = srcs[i];
        else { img.remove(); a.classList.add('noimg'); }
      };
      img.src = srcs[0];
      a.append(img);
    } else {
      a.classList.add('noimg');
    }

    const cap = document.createElement('span'); cap.className = 'cap';
    const d = document.createElement('span'); d.className = 'd'; d.textContent = shortDate(it.date);
    const t = document.createElement('span'); t.className = 't'; t.textContent = it.title;
    cap.append(d, t);
    if (it.credit) {
      const c = document.createElement('span'); c.className = 'c'; c.textContent = it.credit;
      cap.append(c);
      a.title += `\nCredit: ${it.credit}`;
    }
    a.append(cap);

    const label = { video: 'Video', audio: 'Audio', interactive: 'Interactive' }[it.media_type];
    if (label) {
      const b = document.createElement('span'); b.className = 'badge'; b.textContent = label;
      a.append(b);
    }
    return a;
  }

  function renderMonth({ key, items }, above) {
    const [y, m] = key.split('-').map(Number);
    const sec = document.createElement('section'); sec.className = 'month';
    sec.id = `m-${key}`;
    const h = document.createElement('h2');
    h.textContent = `${MONTHS[m - 1]} ${y} `;
    const n = document.createElement('span'); n.textContent = `${items.length} ${items.length === 1 ? 'picture' : 'pictures'}`;
    h.append(n);
    const grid = document.createElement('div'); grid.className = 'grid';
    grid.append(...items.map(tile));
    sec.append(h, grid);
    if (above) main.prepend(sec); else main.append(sec);
  }

  const sentinelVisible = () => sentinel.getBoundingClientRect().top < window.innerHeight + 1200;

  // Render months until the page is filled a screen or so past the bottom.
  function fill() {
    if (searching) return;
    let budget = 6; // months per pass, so a jump never blocks for long
    while (next < months.length && budget-- > 0 && sentinelVisible()) renderMonth(months[next++]);
    if (next >= months.length && months.length) {
      if (complete) setStatus('info', `You reached the earliest picture in apod.json: ${shortDate(all[all.length - 1].date)}.`);
      else setStatus('loading', ''); // older months arrive with apod.json
    }
    else if (next < months.length && sentinelVisible()) requestAnimationFrame(fill);
  }

  // Render newer months above the grid until there's a screen or so of them above the top,
  // so after a jump you can scroll back up. What's on screen stays in place.
  function fillAbove() {
    if (searching) return;
    let budget = 6;
    while (first > 0 && budget-- > 0 && main.firstElementChild.getBoundingClientRect().top > -1200) prepend(first - 1);
  }
  function prepend(to) {
    const ref = main.firstElementChild, was = ref.getBoundingClientRect().top;
    while (first > to) renderMonth(months[--first], true);
    scrollPage(pageTop() + ref.getBoundingClientRect().top - was); // no change where the browser anchors scrolling itself
  }

  new IntersectionObserver((entries) => {
    if (entries.some((e) => e.isIntersecting)) fill();
  }, { rootMargin: '1200px 0px' }).observe(sentinel);

  function showFrom(index) {
    searching = false;
    first = next = index;
    main.replaceChildren();
    setStatus(null);
    scrollPage(0);
    fill();
    fillAbove();
    showCurrent();
  }

  // --- going to a month ----------------------------------------------------
  // Show the grid from the month `key` (or the nearest older one).
  // With `day` ('YYYY-MM-DD'), also scroll to that day's picture and highlight it.
  // Runs at once when the month is loaded, so callers can rely on the grid having changed.
  let goRun = 0;
  async function goTo(key, day) {
    if (!months.length) return;
    const run = ++goRun;
    if (!complete && key < months[months.length - 1].key) {
      await archive;
      if (!complete || run !== goRun) return; // a later jump replaced this one
    }
    q.value = '';
    const i = months.findIndex((mo) => mo.key <= key);
    showFrom(i < 0 ? months.length - 1 : i);
    const t = day && main.querySelector(`.tile[data-date="${day}"]`);
    if (t) {
      t.scrollIntoView({ block: 'center' });
      t.classList.add('flash');
      setTimeout(() => t.classList.remove('flash'), 2500);
    }
  }

  // --- timeline ------------------------------------------------------------
  // A minimap of the whole archive, newest at the top, drawn as hashes like the iOS photo
  // straightening wheel. A yellow line marks where the page is, partway between hashes while
  // you're partway through a month, and the hashes near it glow. Click or drag anywhere to go
  // to that month, or click a year to go to the start of that year.
  const rail = $('rail'), track = $('railTrack'), dial = $('railDial');
  const bubble = $('railBubble');

  // The toolbar's timeline button shows or hides it. This browser remembers which.
  const railToggle = $('railToggle');
  function showRail(on) {
    document.documentElement.classList.toggle('no-rail', !on);
    railToggle.setAttribute('aria-pressed', on);
    try { localStorage.setItem('apod-rail', on ? 'on' : 'off'); } catch {}
  }
  railToggle.addEventListener('click', () => showRail(document.documentElement.classList.contains('no-rail')));
  try { if (localStorage.getItem('apod-rail') === 'off') showRail(false); } catch {}
  const header = document.querySelector('header.bar');
  const ctx = dial.getContext('2d');
  const rgb = (name) => { const h = getComputedStyle(document.documentElement).getPropertyValue(name).trim(); return [1, 3, 5].map((k) => parseInt(h.slice(k, k + 2), 16)); };
  const DUST = rgb('--dust'), STAR = rgb('--star'), GLOW = rgb('--glow');
  const mix = (a, b, t) => `rgb(${a.map((d, k) => Math.round(d + (b[k] - d) * t)).join()})`;
  const PAD = 8;     // px between the newest or earliest month and the end of the track
  const REACH = 40;  // px either side of the line where hashes glow
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const monthName = (key) => `${MONTHS[+key.slice(5, 7) - 1]} ${key.slice(0, 4)}`;

  let calendar = [];   // 'YYYY-MM', newest first
  let years = [];      // [{ year, i }], each at the middle of that year's months
  let labels = [];     // [{ year, y }] as last drawn, for clicks on a year
  let current = null;  // the month at the top of the screen
  let pos = 0;         // the fractional index into calendar at the line: 3.5 is halfway through month 3
  let target = 0;      // where pos is easing to
  let drag = null;     // { y, year, top, height } while the pointer is down
  let hovering = false;
  let frame = 0, lastT = 0;

  const monthAt = (p) => Math.max(0, Math.min(calendar.length - 1, Math.floor(p + 0.01)));
  const perMonth = (h) => (h - 2 * PAD) / calendar.length; // px
  const yAt = (p, h) => PAD + p * perMonth(h);

  function buildRail(earliest, latest) {
    const at = calendar[monthAt(pos)];
    calendar = [];
    let y = +latest.slice(0, 4), m = +latest.slice(5, 7);
    for (const end = earliest.slice(0, 7); ;) {
      const key = `${y}-${String(m).padStart(2, '0')}`;
      if (key < end) break;
      calendar.push(key);
      if (--m === 0) { m = 12; y--; }
    }
    years = [];
    calendar.forEach((key, i) => {
      const year = key.slice(0, 4);
      if (!years.length || years[years.length - 1].year !== year) years.push({ year, first: i, i });
      const yr = years[years.length - 1];
      yr.i = (yr.first + i + 1) / 2;
    });
    track.setAttribute('aria-valuemin', 0);
    track.setAttribute('aria-valuemax', calendar.length - 1);
    pos = target = Math.max(0, calendar.indexOf(at));
    rail.hidden = false;
    showCurrent();
    draw();
  }

  function draw() {
    const w = dial.clientWidth, h = dial.clientHeight, dpr = devicePixelRatio || 1;
    if (!w || !h) return;
    if (dial.width !== Math.round(w * dpr) || dial.height !== Math.round(h * dpr)) {
      dial.width = Math.round(w * dpr); dial.height = Math.round(h * dpr);
    }
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, w, h);
    if (!calendar.length) return;

    const right = w - 4, line = yAt(pos, h), per = perMonth(h);
    // A hash per month when there's room, else every 2nd, 3rd, 6th or 12th month, always on January.
    const step = [1, 2, 3, 6].find((s) => s * per >= 4) || 12;
    ctx.lineCap = 'round';
    calendar.forEach((key, i) => {
      if ((+key.slice(5, 7) - 1) % step) return;
      const y = yAt(i, h);
      const near = Math.max(0, 1 - Math.abs(y - line) / REACH); // 1 at the line, 0 past REACH
      const jan = key.endsWith('-01');
      const len = (jan ? 11 : 7) + 12 * near * near;
      ctx.globalAlpha = Math.min(1, (jan ? 0.55 : 0.35) + 0.65 * near);
      ctx.strokeStyle = mix(DUST, STAR, near ** 1.5);
      ctx.lineWidth = 1 + near ** 4;
      ctx.beginPath(); ctx.moveTo(right - len, y); ctx.lineTo(right, y); ctx.stroke();
    });
    ctx.globalAlpha = 1;
    ctx.strokeStyle = mix(GLOW, GLOW, 0);
    ctx.lineWidth = 2;
    ctx.beginPath(); ctx.moveTo(right - 22, line); ctx.lineTo(right + 2, line); ctx.stroke();

    // Label every year when there's room, else every 2nd or 5th, never overlapping.
    const here = calendar[monthAt(pos)].slice(0, 4);
    const every = 12 * per >= 15 ? 1 : 12 * per >= 7.5 ? 2 : 5;
    ctx.font = `500 10px ${getComputedStyle(document.body).getPropertyValue('--font-mono')}`;
    ctx.textAlign = 'right'; ctx.textBaseline = 'middle';
    labels = [];
    let last = -Infinity;
    for (const { year, i } of years) {
      const y = yAt(i, h);
      if (+year % every || y - last < 13) continue;
      last = y;
      labels.push({ year, y });
      ctx.globalAlpha = year === here ? 1 : 0.7;
      ctx.fillStyle = year === here ? mix(GLOW, GLOW, 0) : mix(DUST, DUST, 0);
      ctx.fillText(year, right - 26, y);
    }
    ctx.globalAlpha = 1;
  }

  // Ease the line toward target after a jump, redrawing as it goes.
  function animate(t) {
    const dt = lastT ? Math.min(50, t - lastT) : 16;
    lastT = t; frame = 0;
    if (!drag) {
      pos = still ? target : pos + (target - pos) * (1 - Math.pow(0.75, dt / 16));
      if (Math.abs(target - pos) < 0.005) pos = target;
    }
    draw();
    if (!drag && pos !== target) frame = requestAnimationFrame(animate);
    else lastT = 0;
  }
  const kick = () => { if (!frame) frame = requestAnimationFrame(animate); };

  function setAria(i) {
    // Sliders count up toward the top, so older months get lower values.
    track.setAttribute('aria-valuenow', calendar.length - 1 - i);
    track.setAttribute('aria-valuetext', monthName(calendar[i]));
  }

  // Show `i` at the bubble: by the line while dragging, or at `y` when hovering.
  function showBubble(i, y) {
    bubble.hidden = false;
    bubble.textContent = monthName(calendar[i]);
    bubble.style.top = `${y === undefined ? yAt(pos, track.clientHeight) : y - track.getBoundingClientRect().top}px`;
  }

  // Move the line to month `i` and show it in the grid.
  function select(i) {
    target = i;
    setAria(i);
    if (!hovering) bubble.hidden = true;
    kick();
    showAt(i);
  }


  const indexAt = (clientY) => {
    const r = track.getBoundingClientRect();
    return monthAt((clientY - r.top - PAD) / perMonth(r.height));
  };

  // Find how far the page is through the month at the top of the screen, below the toolbar,
  // and move the line to match: 0 at the month's heading, almost 1 at its last row.
  function showCurrent() {
    track.classList.toggle('idle', searching);
    if (searching) { current = null; return; }
    const top = header.getBoundingClientRect().bottom;
    const sec = [...main.querySelectorAll('section.month')].find((s) => s.getBoundingClientRect().bottom > top + 48); // past the gap above the next heading
    if (!sec) return;
    current = sec.id.slice(2);
    setAddress(current);
    const i = calendar.indexOf(current);
    if (i < 0 || drag || glideTo) return; // the line is already headed there
    const r = sec.getBoundingClientRect();
    const p = i + Math.max(0, Math.min(0.99, (top - r.top) / r.height));
    setAria(i);
    target = p;
    // Scrolling moves the line with the page; a jump of a month or more glides there.
    if (Math.abs(p - pos) < 1) { pos = p; draw(); }
    else kick();
  }

  // Keep ?date= in the address on the month on screen, so a reload or a shared link opens there.
  // The newest month needs none. A day from the address stays while its month is on screen.
  function setAddress(key) {
    const u = new URL(location.href), was = u.searchParams.get('date') || '';
    if (key === calendar[0]) u.searchParams.delete('date');
    else if (!was.startsWith(key)) u.searchParams.set('date', key);
    if (u.href !== location.href) try { history.replaceState(null, '', u); } catch {}
  }

  let scrollQueued = false;
  addEventListener('scroll', () => {
    if (scrollQueued) return;
    scrollQueued = true;
    requestAnimationFrame(() => { scrollQueued = false; fillAbove(); showCurrent(); });
  }, { passive: true });

  // While the pointer is down, the line follows it and the grid follows the line, to the start
  // of the month under it. At most once a frame. The page is shifted rather than scrolled
  // until the pointer is up (see scrollPage).
  let scrubFrame = 0, scrubTo = 0;
  function scrub(clientY) {
    pos = target = Math.max(0, Math.min(calendar.length - 0.01, (clientY - drag.top - PAD) / perMonth(drag.height)));
    showBubble(monthAt(pos));
    draw();
    scrubTo = monthAt(pos);
    if (!scrubFrame) scrubFrame = requestAnimationFrame(flushScrub);
  }
  function flushScrub() {
    if (!scrubFrame) return;
    cancelAnimationFrame(scrubFrame);
    scrubFrame = 0;
    showAt(scrubTo);
  }

  // Show month `i`: glide to it when it's drawn or within a year of the drawn months (drawing
  // the months between), else draw the grid from it.
  let glideTo = null, glideFrame = 0;
  function showAt(i) {
    const sec = searching ? null : nearby(calendar[i]);
    if (!sec) { glideTo = null; goTo(calendar[i]); return; }
    goRun++; // drop any jump still waiting for apod.json
    glideTo = sec;
    if (!glideFrame) glideFrame = requestAnimationFrame(glide);
  }
  function nearby(key) {
    const j = months.findIndex((mo) => mo.key <= key);
    if (j < 0 || j < first - 12 || j > next + 12) return null;
    if (j < first) prepend(j);
    while (next <= j) renderMonth(months[next++]);
    return document.getElementById(`m-${months[j].key}`);
  }
  // Ease the page toward glideTo's heading, re-measuring each frame as months are added.
  function glide() {
    glideFrame = 0;
    if (!glideTo) return;
    const want = Math.min(maxTop(), pageTop() + glideTo.getBoundingClientRect().top - header.getBoundingClientRect().bottom);
    const d = want - pageTop();
    if (still || Math.abs(d) < 1) { scrollPage(want); glideTo = null; return; }
    scrollPage(pageTop() + d * 0.3);
    glideFrame = requestAnimationFrame(glide);
  }
  // Scrolling the page yourself stops a glide.
  for (const type of ['wheel', 'touchstart']) {
    addEventListener(type, (e) => { if (!track.contains(e.target)) glideTo = null; }, { passive: true });
  }

  track.addEventListener('pointerdown', (e) => {
    if (!calendar.length || e.button > 0) return;
    e.preventDefault();
    track.setPointerCapture(e.pointerId);
    const r = track.getBoundingClientRect(), y = e.clientY - r.top;
    const label = e.clientX - r.left < r.width - 26 && labels.find((l) => Math.abs(l.y - y) < 7);
    drag = { y: e.clientY, year: label ? label.year : null, top: r.top, height: r.height };
    scrub(e.clientY);
  });
  track.addEventListener('pointermove', (e) => {
    if (!calendar.length) return;
    if (drag) scrub(e.clientY);
    else if (e.pointerType === 'mouse') showBubble(indexAt(e.clientY), e.clientY);
  });
  track.addEventListener('pointerup', (e) => {
    if (!drag) return;
    // The grid is already there; a click on a year label goes to the start of that year (its newest month).
    const year = Math.abs(e.clientY - drag.y) < 4 && drag.year;
    drag = null;
    release();
    if (year) {
      cancelAnimationFrame(scrubFrame);
      scrubFrame = 0;
      select(calendar.findIndex((k) => k.startsWith(year)));
    } else {
      flushScrub();
      setAria(monthAt(pos));
      if (!hovering) bubble.hidden = true;
    }
  });
  track.addEventListener('pointercancel', () => { drag = null; release(); bubble.hidden = true; showCurrent(); });
  track.addEventListener('pointerenter', () => { hovering = true; });
  track.addEventListener('pointerleave', () => { hovering = false; if (!drag) bubble.hidden = true; });

  track.addEventListener('keydown', (e) => {
    const step = { ArrowUp: -1, ArrowDown: 1, PageUp: -12, PageDown: 12 }[e.key];
    let i = monthAt(target);
    if (e.key === 'Home') i = 0;
    else if (e.key === 'End') i = calendar.length - 1;
    else if (step) i = Math.max(0, Math.min(calendar.length - 1, i + step));
    else return;
    e.preventDefault();
    select(i);
  });

  new ResizeObserver(() => document.documentElement.style.setProperty('--bar-h', `${header.offsetHeight}px`)).observe(header);
  new ResizeObserver(draw).observe(track);

  // --- search --------------------------------------------------------------
  // Uses the Pagefind index (pagefind/, built by build-search.mjs) when it's there, which
  // covers titles, credits and explanations. Without it, matches titles and credits only.
  const SEARCH_PAGE = 48;
  const q = $('q');
  let pagefind = null;
  const pagefindReady = import('./pagefind/pagefind.js')
    .then(async (pf) => { await pf.options({ excerptLength: 0 }); await pf.init(); pagefind = pf; })
    .catch(() => {});
  let searchRun = 0;

  const fromPagefind = ({ meta: m }) => ({
    date: m.date, title: m.title, link: m.link, thumb: m.image, image: m.image_full,
    credit: m.credit, media_type: m.media_type, alt: m.alt,
  });

  async function runSearch(query) {
    const run = ++searchRun;
    if (!query) { if (searching) showFrom(0); return; }
    searching = true;
    await pagefindReady;

    let results; // functions that each load one entry, so only a page's worth is fetched at a time
    if (pagefind) {
      const r = await pagefind.search(query);
      results = r.results.map((x) => async () => fromPagefind(await x.data()));
    } else {
      await archive;
      const words = query.toLowerCase().split(/\s+/).filter(Boolean);
      results = all
        .filter((e) => { const hay = `${e.title} ${e.credit || ''}`.toLowerCase(); return words.every((w) => hay.includes(w)); })
        .map((e) => async () => e);
    }
    if (run !== searchRun) return;

    const sec = document.createElement('section'); sec.className = 'month';
    const h = document.createElement('h2');
    h.textContent = `“${query}” `;
    const n = document.createElement('span');
    n.textContent = `${results.length.toLocaleString()} ${results.length === 1 ? 'day' : 'days'}${pagefind ? '' : ' (titles and credits)'}`;
    h.append(n);
    const grid = document.createElement('div'); grid.className = 'grid';
    const more = document.createElement('button'); more.className = 'btn more'; more.textContent = 'Show more';
    sec.append(h, grid, more);
    main.replaceChildren(sec);
    window.scrollTo({ top: 0 });
    showCurrent();
    setStatus(results.length ? null : 'info', `No days match “${query}”.`);

    let shown = 0;
    async function showMore() {
      const batch = results.slice(shown, shown + SEARCH_PAGE);
      shown += batch.length;
      more.hidden = true;
      const items = await Promise.all(batch.map((load) => load()));
      if (run !== searchRun) return;
      grid.append(...items.map(tile));
      more.hidden = shown >= results.length;
    }
    more.onclick = showMore;
    await showMore();
  }

  let searchTimer;
  q.addEventListener('input', () => {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => runSearch(q.value.trim()), 250);
  });
  q.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') { q.value = ''; runSearch(''); }
  });

  // --- start ---------------------------------------------------------------
  function setData(entries) {
    all = entries.filter((e) => e && e.date && e.link).sort((a, b) => (a.date < b.date ? 1 : -1));
    const byKey = new Map();
    for (const e of all) {
      const key = e.date.slice(0, 7);
      if (!byKey.has(key)) byKey.set(key, []);
      byKey.get(key).push(e);
    }
    months = [...byKey].map(([key, items]) => ({ key, items }));
  }

  function showSummary(total, earliest, latest) {
    const [from, to] = [earliest.slice(0, 4), latest.slice(0, 4)];
    const years = from === to ? to : `${from}–${to}`;
    $('count').textContent = `${total.toLocaleString()} pictures, ${years}`;
    buildRail(earliest, latest);
  }

  async function loadArchive() {
    let data;
    try {
      const res = await fetch(DATA_URL, { cache: 'no-cache' });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      data = await res.json();
    } catch (e) {
      setStatus('error', location.protocol === 'file:'
        ? 'Browsers block loading apod.json from a file. In this folder, run "python3 -m http.server" and open http://localhost:8000.'
        : `Couldn't load apod.json (${e.message}). Run "node fetch-apod.mjs --last 10" in this folder to create it.`);
      return;
    }

    // Carry on after the last month shown, which may have moved if apod.json is newer than the page.
    const top = next > 0 ? months[first].key : null, last = next > 0 ? months[next - 1].key : null;
    setData(data);
    if (!months.length) { setStatus('error', 'apod.json has no entries yet. Run "node fetch-apod.mjs --last 10" to add some.'); return; }
    if (last) {
      const i = months.findIndex((mo) => mo.key < last);
      next = i < 0 ? months.length : i;
      first = Math.max(0, months.findIndex((mo) => mo.key <= top));
    }
    complete = true;

    showSummary(all.length, all[all.length - 1].date, all[0].date);
    if (!searching) { setStatus(null); fill(); }
  }

  function start() {
    // ?date=YYYY-MM-DD, YYYY-MM or YYYY. A year opens at its newest month.
    const want = (new URLSearchParams(location.search).get('date') || '').match(/^(\d{4})(?:-(\d{2})(?:-(\d{2}))?)?$/);
    const wantKey = want && `${want[1]}-${want[2] || '12'}`;
    const seed = JSON.parse($('seed').textContent || 'null');
    if (seed && seed.recent.length) {
      setData(seed.recent);
      showSummary(seed.total, seed.earliest, all[0].date);
      // goTo below shows a date in these months at once; an older one waits for apod.json,
      // with only a spinner meanwhile.
      if (!wantKey) showFrom(0);
      else if (wantKey < months[months.length - 1].key) setStatus('loading', '');
    } else {
      // Unbuilt index.html, as when serving this folder directly.
      setStatus('loading', 'Loading the archive…');
    }
    archive = loadArchive();
    if (wantKey) {
      const day = want[3] && want[0];
      if (months.length) goTo(wantKey, day);
      else archive.then(() => goTo(wantKey, day));
    }
  }
  start();

  // sw.js keeps NASA's thumbnails on this device, so later visits don't fetch them again.
  // Browsers allow service workers only over HTTPS and on localhost.
  if ('serviceWorker' in navigator && window.isSecureContext) {
    navigator.serviceWorker.register('sw.js').catch(() => {});
  }
})();
</script>
</body>
</html>

