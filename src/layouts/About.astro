---
import GitHubIcon from '@tabler/icons/outline/brand-github.svg';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<link rel="icon" href="favicon.svg" type="image/svg+xml">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>About APOD Grid</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;800&family=IBM+Plex+Mono:wght@400;500&display=swap">
<style is:inline>
/* The About page's frame: Astro puts src/pages/about.md, as HTML, in its main element.
   The same night-sky palette and toolbar as the grid (index.html), with one column of reading text. */
:root {
  --sky: #07090f;        /* page background: night sky */
  --panel: #10141f;      /* toolbar and code background */
  --line: #1f2636;       /* hairlines and borders */
  --star: #e8ecf5;       /* primary text */
  --dust: #8a93a8;       /* secondary text */
  --glow: #f2b84b;       /* accent: warm starlight */
  --font-display: "Archivo", system-ui, sans-serif;
  --font-body: "Archivo", system-ui, sans-serif;
  --font-mono: "IBM Plex Mono", ui-monospace, Menlo, monospace;
  color-scheme: dark;
}
* { box-sizing: border-box; }
html, body { margin: 0; }
body {
  background: var(--sky);
  color: var(--star);
  font: 16px/1.65 var(--font-body);
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
}
a { color: inherit; text-decoration-color: color-mix(in srgb, var(--glow) 60%, transparent); text-underline-offset: 3px; }
a:hover { color: var(--glow); }
:focus-visible { outline: 2px solid var(--glow); outline-offset: 2px; }

header.bar {
  position: sticky; top: env(safe-area-inset-top, 0px); z-index: 5;
  display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px;
  padding-block: 14px;
  margin-inline: calc(-1 * max(16px, env(safe-area-inset-left, 0px))) calc(-1 * max(16px, env(safe-area-inset-right, 0px)));
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
  background: color-mix(in srgb, var(--sky) 88%, transparent);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--line);
}
.brand { display: flex; align-items: baseline; gap: 10px; margin-right: auto; text-decoration: none; }
.brand h1 { margin: 0; font: 800 20px/1 var(--font-display); letter-spacing: -0.01em; }
.brand h1 span { color: var(--glow); }
.brand small { font: 400 12px var(--font-mono); color: var(--dust); }
.links { display: flex; gap: 8px; }
.btn {
  background: var(--panel); border: 1px solid var(--line); border-radius: 6px;
  display: inline-flex; align-items: center; gap: 6px;
  padding: 6px 12px; text-decoration: none; font-size: 14px; white-space: nowrap;
}
/* Icons are Tabler's (MIT), imported as components in the frontmatter. They're drawn with
   strokes in the text colour. */
.btn .icon { width: 16px; height: 16px; flex: none; }
.btn:hover { border-color: var(--dust); color: var(--star); }

main { max-width: 68ch; padding-block: 32px 48px; }
h2 { margin: 48px 0 8px; font: 600 22px/1.25 var(--font-display); }
h2:first-child { margin-top: 0; }
h3 { margin: 28px 0 4px; font: 600 17px/1.3 var(--font-display); }
/* Each h3 is a build step, numbered 01, 02, … */
main { counter-reset: step; }
main h3::before {
  counter-increment: step; content: counter(step, decimal-leading-zero);
  font: 500 12px var(--font-mono); color: var(--glow); margin-right: 8px; letter-spacing: 0.04em;
}
p, ul, ol { margin: 0 0 14px; }
ul, ol { padding-left: 22px; }
li { margin-bottom: 6px; }
h2:first-child + p { font-size: 18px; } /* the opening paragraph */
/* A list item's bold lead-in, as in "Using it" */
li > strong:first-child { font: 500 13.5px var(--font-mono); color: var(--glow); margin-right: 4px; }
code {
  font: 400 13.5px var(--font-mono); background: var(--panel); border: 1px solid var(--line);
  border-radius: 4px; padding: 1px 5px; overflow-wrap: anywhere;
}
pre {
  font: 400 13.5px/1.6 var(--font-mono); background: var(--panel); border: 1px solid var(--line);
  border-radius: 6px; padding: 12px 14px; overflow-x: auto; margin: 0 0 14px;
}
pre code { background: none; border: 0; padding: 0; }
footer { color: var(--dust); font-size: 13px; padding-block: 0 32px; max-width: 68ch; border-top: 1px solid var(--line); padding-top: 16px; }
</style>
</head>
<body>
<header class="bar">
  <a class="brand" href="./">
    <h1>APOD <span>Grid</span></h1>
    <small>About</small>
  </a>
  <nav class="links" aria-label="Site">
    <a class="btn" href="./">Back to the grid</a>
    <a class="btn" href="https://github.com/lbeckman314/apod-grid" target="_blank" rel="noopener"><GitHubIcon class="icon" aria-hidden="true" />GitHub</a>
  </nav>
</header>

<main>
<slot />
</main>

<footer>
  Pictures and text from NASA's <a href="https://science.nasa.gov/apod/" target="_blank" rel="noopener">Astronomy Picture of the Day</a>. Source on <a href="https://github.com/lbeckman314/apod-grid" target="_blank" rel="noopener">GitHub</a>.
</footer>
</body>
</html>
